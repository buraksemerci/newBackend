# Environment
NODE_ENV=development
PORT=3000

# Database (SQL Server)
DATABASE_URL="sqlserver://localhost:1433;database=fitness_app;user=sa;password=YourPassword123;trustServerCertificate=true"

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourapp.com
SENDGRID_FROM_NAME=Fitness App

# Social Auth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Social Auth - Apple
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./keys/apple-auth-key.p8

# Social Auth - Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cleanup Job
CLEANUP_INTERVAL_MS=900000
UNVERIFIED_ACCOUNT_TTL_DAYS=7
INACTIVE_DEVICE_TTL_DAYS=30

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
