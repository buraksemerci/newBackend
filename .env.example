# ================================================
# FitMark Backend - Environment Variables
# ================================================

# App
NODE_ENV=development
PORT=3000

# Azure SQL Database
DB_SERVER=your-server.database.windows.net
DB_DATABASE=your-database
DB_USER=your-username
DB_PASSWORD=your-password
DB_PORT=1433

# DATABASE_URL is auto-generated from above variables
# Format: sqlserver://server:port;database=db;user=user;password=pass;encrypt=true

# JWT Tokens
ACCESS_TOKEN_SECRET=your-secret-at-least-32-characters-long
REFRESH_TOKEN_SECRET=your-refresh-secret-at-least-32-chars
ACCESS_TOKEN_LIFE=15m
REFRESH_TOKEN_LIFE=7d

# Azure Communication Services (Email)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your-key
AZURE_SENDER=DoNotReply@yourdomain.com

# Social Auth - Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Social Auth - Apple (optional)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Social Auth - Facebook (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Rate Limiting (optional - defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cleanup Job (optional - defaults shown)
CLEANUP_INTERVAL_MS=900000
UNVERIFIED_ACCOUNT_TTL_DAYS=7
INACTIVE_DEVICE_TTL_DAYS=30

# Logging (optional - defaults shown)
LOG_LEVEL=info
LOG_DIR=./logs
