generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["aaAuth", "aaExercise", "aaMaster", "aaProfile"]
}

// ============================================================================
// AUTH SCHEMA - Kullanıcı ve Kimlik Doğrulama
// ============================================================================

/// Ana kullanıcı tablosu - UUIDv7 (backend-generated)
model User {
  user_id                 String                 @id @map("user_id") @db.NVarChar(36)
  email                   String                 @unique @map("email") @db.NVarChar(255)
  username                String                 @unique @map("username") @db.NVarChar(16)
  is_email_verified       Boolean                @default(false) @map("is_email_verified")
  username_last_changed_at DateTime?             @map("username_last_changed_at")
  created_at              DateTime               @default(now()) @map("created_at")
  updated_at              DateTime               @updatedAt @map("updated_at")
  deleted_at              DateTime?              @map("deleted_at")
  
  // Relations
  refresh_tokens          RefreshToken[]
  body                    UserBody?
  devices                 UserDevice[]
  external_logins         UserExternalLogin[]
  goals                   UserGoals?
  health_limitations      UserHealthLimitation[]
  local_credential        UserLocalCredential?
  profile                 UserProfile?
  settings                UserSetting?
  verification_tokens     VerificationToken[]
  
  // Social Relations
  user_body_targets       UserBodyTarget[]
  connections_low         UserConnection[]       @relation("ConnectionLow")
  connections_high        UserConnection[]       @relation("ConnectionHigh")
  connections_requested   UserConnection[]       @relation("ConnectionRequester")
  connections_received    UserConnection[]       @relation("ConnectionReceiver")
  
  blocks_initiated        UserBlock[]            @relation("Blocker")
  blocks_received         UserBlock[]            @relation("Blocked")
  
  connection_counts       UserConnectionCount?
  privacy_settings        UserPrivacySetting?

  @@map("users")
  @@schema("aaAuth")
}

/// Şifre bilgileri - INT (iç tablo)
model UserLocalCredential {
  user_local_credential_id Int       @id @default(autoincrement()) @map("user_local_credential_id")
  user_id                  String    @unique @map("user_id") @db.NVarChar(36)
  password_hash            String    @map("password_hash") @db.NVarChar(255)
  failed_attempts          Int       @default(0) @map("failed_attempts")
  locked_until             DateTime? @map("locked_until")
  last_password_change_at  DateTime  @default(now()) @map("last_password_change_at")
  created_at               DateTime  @default(now()) @map("created_at")
  updated_at               DateTime  @updatedAt @map("updated_at")
  
  user                     User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_local_credentials")
  @@schema("aaAuth")
}

/// Sosyal login bilgileri - Composite PK
model UserExternalLogin {
  user_id      String   @map("user_id") @db.NVarChar(36)
  provider     String   @map("provider") @db.NVarChar(20)
  provider_key String   @map("provider_key") @db.NVarChar(255)
  created_at   DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, provider, provider_key])
  @@map("user_external_logins")
  @@schema("aaAuth")
}

/// Refresh tokenları - UUIDv7 (backend-generated)
model RefreshToken {
  refresh_token_id String     @id @map("refresh_token_id") @db.NVarChar(36)
  user_id          String     @map("user_id") @db.NVarChar(36)
  user_device_id   String     @map("user_device_id") @db.NVarChar(36)
  token_hash       String     @unique @map("token_hash") @db.NVarChar(128)
  expires_at       DateTime   @map("expires_at")
  created_at       DateTime   @default(now()) @map("created_at")
  
  device           UserDevice @relation(fields: [user_device_id], references: [user_device_id], onUpdate: NoAction)
  user             User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("aaAuth")
}

/// Doğrulama tokenları (email verification + password reset) - UUIDv7
model VerificationToken {
  verification_token_id String   @id @map("verification_token_id") @db.NVarChar(36)
  user_id               String   @map("user_id") @db.NVarChar(36)
  type                  String   @map("type") @db.NVarChar(30)
  token_hash            String   @map("token_hash") @db.NVarChar(128)
  expires_at            DateTime @map("expires_at")
  is_used               Boolean  @default(false) @map("is_used")
  attempts_left         Int      @default(5) @map("attempts_left")
  sent_count            Int      @default(1) @map("sent_count")
  last_sent_at          DateTime @default(now()) @map("last_sent_at")
  created_at            DateTime @default(now()) @map("created_at")
  
  user                  User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, type])
  @@map("verification_tokens")
  @@schema("aaAuth")
}

/// Cihaz bilgileri - UUIDv7 (backend-generated)
model UserDevice {
  user_device_id String         @id @map("user_device_id") @db.NVarChar(36)
  user_id        String         @map("user_id") @db.NVarChar(36)
  device_id      String         @map("device_id") @db.NVarChar(100)
  device_name    String?        @map("device_name") @db.NVarChar(100)
  device_type    String         @map("device_type") @db.NVarChar(20)
  fcm_token      String?        @map("fcm_token") @db.NVarChar(500)
  last_active_at DateTime       @default(now()) @map("last_active_at")
  created_at     DateTime       @default(now()) @map("created_at")
  
  refresh_tokens RefreshToken[]
  user           User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, device_id])
  @@map("user_devices")
  @@schema("aaAuth")
}

// ============================================================================
// PROFILE SCHEMA - Kullanıcı Profili ve Tercihleri
// ============================================================================

/// Profil bilgileri - user_id PK (1:1 ilişki)
model UserProfile {
  user_id              String          @id @map("user_id") @db.NVarChar(36)
  first_name           String          @map("first_name") @db.NVarChar(50)
  last_name            String          @map("last_name") @db.NVarChar(50)
  birth_date           DateTime        @map("birth_date")
  gender               String          @map("gender") @db.NVarChar(10)
  experience_level_id  Int             @default(1) @map("experience_level_id") // 1, 2, or 3
  created_at           DateTime        @default(now()) @map("created_at")
  updated_at           DateTime        @updatedAt @map("updated_at")
  
  user                 User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  experience_level     ExperienceLevel @relation(fields: [experience_level_id], references: [experience_level_id])

  @@map("user_profiles")
  @@schema("aaProfile")
}

/// Vücut ölçüleri - user_id PK (1:1 ilişki)
model UserBody {
  user_id          String   @id @map("user_id") @db.NVarChar(36)
  height_cm        Decimal  @map("height_cm") @db.Decimal(5, 2)
  weight_kg        Decimal  @map("weight_kg") @db.Decimal(5, 2)
  target_weight_kg Decimal? @map("target_weight_kg") @db.Decimal(5, 2)
  somatotype       String   @map("somatotype") @db.NVarChar(20)
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")
  
  user             User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_bodies")
  @@schema("aaProfile")
}

/// Kullanıcı ayarları - user_id PK (1:1 ilişki)
model UserSetting {
  user_id           String   @id @map("user_id") @db.NVarChar(36)
  preferred_unit    String   @default("METRIC") @map("preferred_unit") @db.NVarChar(20)
  language_id       Int      @map("language_id")
  theme             String   @default("SYSTEM") @map("theme") @db.NVarChar(20)
  workout_reminders Boolean  @default(true) @map("workout_reminders")
  progress_updates  Boolean  @default(true) @map("progress_updates")
  created_at        DateTime @default(now()) @map("created_at")
  updated_at        DateTime @updatedAt @map("updated_at")
  
  language          Language @relation(fields: [language_id], references: [language_id], onUpdate: NoAction)
  user              User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_settings")
  @@schema("aaProfile")
}

/// Kullanıcı hedefleri - user_id PK (1:1 ilişki)
model UserGoals {
  user_id         String           @id @map("user_id") @db.NVarChar(36)
  fitness_goal_id Int              @map("fitness_goal_id")
  created_at      DateTime         @default(now()) @map("created_at")
  updated_at      DateTime         @updatedAt @map("updated_at")
  

  fitness_goal    FitnessGoal      @relation(fields: [fitness_goal_id], references: [fitness_goal_id], onUpdate: NoAction)
  user            User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_goals")
  @@schema("aaProfile")
}

/// Kullanıcı sağlık kısıtlamaları - Composite PK (M:N) + user_severity
model UserHealthLimitation {
  user_id              String           @map("user_id") @db.NVarChar(36)
  health_limitation_id Int              @map("health_limitation_id")
  user_severity        Int              @default(1) @map("user_severity") // 1-3: Kullanıcının durumu
  created_at           DateTime         @default(now()) @map("created_at")
  
  health_limitation    HealthLimitation @relation(fields: [health_limitation_id], references: [health_limitation_id], onDelete: Cascade)
  user                 User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, health_limitation_id])
  @@map("user_health_limitations")
  @@schema("aaProfile")
}

/// Kullanıcı vücut hedefleri - Composite PK (M:N to User)
model UserBodyTarget {
  user_id            String     @map("user_id") @db.NVarChar(36)
  body_target_id     Int        @map("body_target_id")
  created_at         DateTime   @default(now()) @map("created_at")
  
  body_target        BodyTarget @relation(fields: [body_target_id], references: [body_target_id], onDelete: Cascade)
  user               User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, body_target_id])
  @@map("user_body_targets")
  @@schema("aaProfile")
}

// ============================================================================
// SOCIAL SCHEMA - Arkadaşlık ve Bağlantılar
// ============================================================================

/// Kullanıcı bağlantıları (Arkadaşlıklar)
model UserConnection {
  connection_id    String    @id @map("connection_id") @db.NVarChar(36)
  low_user_id      String    @map("low_user_id") @db.NVarChar(36)
  high_user_id     String    @map("high_user_id") @db.NVarChar(36)
  requester_id     String    @map("requester_id") @db.NVarChar(36)
  receiver_id      String    @map("receiver_id") @db.NVarChar(36)
  status           String    @map("status") @db.NVarChar(20) // PENDING, ACCEPTED, DECLINED
  
  created_at       DateTime  @default(now()) @map("created_at")
  responded_at     DateTime? @map("responded_at")
  declined_until   DateTime? @map("declined_until")
  
  // Relations - low/high for uniqueness, requester/receiver for clarity
  low_user         User      @relation("ConnectionLow", fields: [low_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  high_user        User      @relation("ConnectionHigh", fields: [high_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  requester        User      @relation("ConnectionRequester", fields: [requester_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  receiver         User      @relation("ConnectionReceiver", fields: [receiver_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([low_user_id, high_user_id])
  @@index([low_user_id, status])
  @@index([high_user_id, status])
  @@index([requester_id])
  @@index([receiver_id])
  @@map("user_connections")
  @@schema("aaProfile")
}

/// Engellenen kullanıcılar
model UserBlock {
  blocker_id   String   @map("blocker_id") @db.NVarChar(36)
  blocked_id   String   @map("blocked_id") @db.NVarChar(36)
  created_at   DateTime @default(now()) @map("created_at")

  blocker      User     @relation("Blocker", fields: [blocker_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  blocked      User     @relation("Blocked", fields: [blocked_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([blocker_id, blocked_id])
  @@index([blocked_id])
  @@map("user_blocks")
  @@schema("aaProfile")
}


/// Bağlantı sayaçları (Denormalized)
model UserConnectionCount {
  user_id                String   @id @map("user_id") @db.NVarChar(36)
  connection_count       Int      @default(0) @map("connection_count")
  pending_received_count Int      @default(0) @map("pending_received_count")
  updated_at             DateTime @updatedAt @map("updated_at")

  user                   User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_connection_counts")
  @@schema("aaProfile")
}

/// Kullanıcı gizlilik ayarları
model UserPrivacySetting {
  user_id                    String   @id @map("user_id") @db.NVarChar(36)
  profile_visibility         String   @default("EVERYONE") @map("profile_visibility") @db.NVarChar(20) // EVERYONE, CONNECTIONS_ONLY, NOBODY
  can_receive_requests_from  String   @default("EVERYONE") @map("can_receive_requests_from") @db.NVarChar(20) // EVERYONE, NOBODY
  updated_at                 DateTime @updatedAt @map("updated_at")

  user                       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_privacy_settings")
  @@schema("aaProfile")
}

// ============================================================================
// MASTER SCHEMA - Lookup/Reference Tablolar
// ============================================================================

/// Diller - INT (lookup)
model Language {
  language_id    Int      @id @default(autoincrement()) @map("language_id")
  language_code  String   @unique @map("language_code") @db.NVarChar(10)
  language_name  String   @map("language_name") @db.NVarChar(50)
  is_active      Boolean  @default(true) @map("is_active")
  created_at     DateTime @default(now()) @map("created_at")
  
  // Master translations
  body_target_translations       BodyTargetTranslation[]
  equipment_translations         EquipmentTranslation[]
  fitness_goal_translations      FitnessGoalTranslation[]
  health_limitation_translations HealthLimitationTranslation[]
  user_settings                  UserSetting[]
  
  // Exercise translations
  exercise_translations            ExerciseTranslation[]
  movement_pattern_translations    MovementPatternTranslation[]
  muscle_translations              MuscleTranslation[]

  @@map("languages")
  @@schema("aaMaster")
}

/// Fitness hedefleri - INT (lookup)
model FitnessGoal {
  fitness_goal_id               Int                      @id @default(autoincrement()) @map("fitness_goal_id")
  fitness_goal_key              String                   @unique @map("fitness_goal_key") @db.NVarChar(50)
  default_set_duration_seconds  Int                      @default(40) @map("default_set_duration_seconds")
  default_rest_duration_seconds Int                      @default(45) @map("default_rest_duration_seconds")
  created_at                    DateTime                 @default(now()) @map("created_at")
  updated_at                    DateTime                 @updatedAt @map("updated_at")
  
  translations     FitnessGoalTranslation[]
  user_goals       UserGoals[]
  goal_attributes  FitnessGoalAttribute[]

  @@map("fitness_goals")
  @@schema("aaMaster")
}

/// Fitness hedefi çevirileri - Composite PK
model FitnessGoalTranslation {
  fitness_goal_id Int         @map("fitness_goal_id")
  language_id     Int         @map("language_id")
  name            String      @map("name") @db.NVarChar(100)
  created_at      DateTime    @default(now()) @map("created_at")
  updated_at      DateTime    @updatedAt @map("updated_at")
  
  fitness_goal    FitnessGoal @relation(fields: [fitness_goal_id], references: [fitness_goal_id], onDelete: Cascade)
  language        Language    @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([fitness_goal_id, language_id])
  @@map("fitness_goal_translations")
  @@schema("aaMaster")
}

/// Vücut hedefleri - INT (lookup)
model BodyTarget {
  body_target_id     Int                     @id @default(autoincrement()) @map("body_target_id")
  muscle_subgroup_id Int                     @map("muscle_subgroup_id")
  target_gender      String                  @map("target_gender") @db.NVarChar(10)
  created_at         DateTime                @default(now()) @map("created_at")
  updated_at         DateTime                @updatedAt @map("updated_at")
  
  muscle_subgroup     MuscleSubgroup          @relation(fields: [muscle_subgroup_id], references: [muscle_subgroup_id])
  translations        BodyTargetTranslation[]
  user_body_targets   UserBodyTarget[]

  @@unique([muscle_subgroup_id, target_gender])
  @@map("body_targets")
  @@schema("aaMaster")
}

/// Vücut hedefi çevirileri - Composite PK
model BodyTargetTranslation {
  body_target_id Int        @map("body_target_id")
  language_id    Int        @map("language_id")
  name           String     @map("name") @db.NVarChar(100)
  created_at     DateTime   @default(now()) @map("created_at")
  updated_at     DateTime   @updatedAt @map("updated_at")
  
  body_target    BodyTarget @relation(fields: [body_target_id], references: [body_target_id], onDelete: Cascade)
  language       Language   @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([body_target_id, language_id])
  @@map("body_target_translations")
  @@schema("aaMaster")
}

/// Sağlık kısıtlamaları - INT (lookup)
model HealthLimitation {
  health_limitation_id    Int                           @id @default(autoincrement()) @map("health_limitation_id")
  health_limitation_key   String                        @unique @map("health_limitation_key") @db.NVarChar(50)
  created_at              DateTime                      @default(now()) @map("created_at")
  updated_at              DateTime                      @updatedAt @map("updated_at")
  
  translations            HealthLimitationTranslation[]
  user_health_limitations UserHealthLimitation[]
  exercise_limitations    ExerciseLimitation[]

  @@map("health_limitations")
  @@schema("aaMaster")
}

/// Sağlık kısıtlaması çevirileri - Composite PK
model HealthLimitationTranslation {
  health_limitation_id Int              @map("health_limitation_id")
  language_id          Int              @map("language_id")
  name                 String           @map("name") @db.NVarChar(100)
  description          String?          @map("description") @db.NVarChar(500)
  created_at           DateTime         @default(now()) @map("created_at")
  updated_at           DateTime         @updatedAt @map("updated_at")
  
  health_limitation    HealthLimitation @relation(fields: [health_limitation_id], references: [health_limitation_id], onDelete: Cascade)
  language             Language         @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([health_limitation_id, language_id])
  @@map("health_limitation_translations")
  @@schema("aaMaster")
}

/// Ekipmanlar - INT (lookup)
model Equipment {
  equipment_id       Int                    @id @default(autoincrement()) @map("equipment_id")
  equipment_key      String                 @unique @map("equipment_key") @db.NVarChar(50)
  created_at         DateTime               @default(now()) @map("created_at")
  updated_at         DateTime               @updatedAt @map("updated_at")
  
  translations       EquipmentTranslation[]
  exercise_equipment ExerciseEquipment[]

  @@map("equipment")
  @@schema("aaMaster")
}

/// Ekipman çevirileri - Composite PK
model EquipmentTranslation {
  equipment_id Int       @map("equipment_id")
  language_id  Int       @map("language_id")
  name         String    @map("name") @db.NVarChar(100)
  created_at   DateTime  @default(now()) @map("created_at")
  updated_at   DateTime  @updatedAt @map("updated_at")
  
  equipment    Equipment @relation(fields: [equipment_id], references: [equipment_id], onDelete: Cascade)
  language     Language  @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([equipment_id, language_id])
  @@map("equipment_translations")
  @@schema("aaMaster")
}

// ============================================================================
// EXERCISE SCHEMA - Egzersiz ve Antrenman Verileri
// ============================================================================

/// Hareket paternleri - INT (lookup)
model MovementPattern {
  movement_pattern_id  Int                          @id @default(autoincrement()) @map("movement_pattern_id")
  movement_pattern_key String                       @unique @map("movement_pattern_key") @db.NVarChar(50)
  created_at           DateTime                     @default(now()) @map("created_at")
  updated_at           DateTime                     @updatedAt @map("updated_at")
  
  translations         MovementPatternTranslation[]
  exercises            Exercise[]

  @@map("movement_patterns")
  @@schema("aaExercise")
}

/// Hareket paterni çevirileri - Composite PK
model MovementPatternTranslation {
  movement_pattern_id Int             @map("movement_pattern_id")
  language_id         Int             @map("language_id")
  name                String          @map("name") @db.NVarChar(100)
  created_at          DateTime        @default(now()) @map("created_at")
  updated_at          DateTime        @updatedAt @map("updated_at")
  
  movement_pattern    MovementPattern @relation(fields: [movement_pattern_id], references: [movement_pattern_id], onDelete: Cascade)
  language            Language        @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([movement_pattern_id, language_id])
  @@map("movement_pattern_translations")
  @@schema("aaExercise")
}

/// Kas grupları - INT (lookup)
model Muscle {
  muscle_id   Int      @id @default(autoincrement()) @map("muscle_id")
  muscle_key  String   @unique @map("muscle_key") @db.NVarChar(50)
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")
  
  translations              MuscleTranslation[]
  exercise_target_muscles   ExerciseTargetMuscle[]
  muscle_subgroup_relations MuscleSubgroupRelation[]

  @@map("muscles")
  @@schema("aaExercise")
}

/// Kas çevirileri - Composite PK
model MuscleTranslation {
  muscle_id   Int      @map("muscle_id")
  language_id Int      @map("language_id")
  name        String   @map("name") @db.NVarChar(100)
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")
  
  muscle      Muscle   @relation(fields: [muscle_id], references: [muscle_id], onDelete: Cascade)
  language    Language @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([muscle_id, language_id])
  @@map("muscle_translations")
  @@schema("aaExercise")
}

/// Egzersizler - INT (lookup)
model Exercise {
  exercise_id               Int      @id @default(autoincrement()) @map("exercise_id")
  exercise_key              String   @unique @map("exercise_key") @db.NVarChar(50)
  movement_pattern_id       Int      @map("movement_pattern_id")
  exercise_experience_level Decimal  @default(1.0) @map("exercise_experience_level") @db.Decimal(2, 1)
  met_value                 Decimal? @map("met_value") @db.Decimal(4, 2)
  compound_level            Int      @default(5) @map("compound_level") // 1, 5, or 10
  created_at                DateTime @default(now()) @map("created_at")
  updated_at                DateTime @updatedAt @map("updated_at")
  
  movement_pattern        MovementPattern              @relation(fields: [movement_pattern_id], references: [movement_pattern_id])
  translations            ExerciseTranslation[]
  exercise_target_muscles ExerciseTargetMuscle[]
  exercise_equipment      ExerciseEquipment[]
  exercise_media          ExerciseMedia[]
  exercise_attributes     ExerciseAttributeRelation[]
  exercise_limitations    ExerciseLimitation[]

  @@map("exercises")
  @@schema("aaExercise")
}

/// Egzersiz çevirileri - Composite PK
model ExerciseTranslation {
  exercise_id Int      @map("exercise_id")
  language_id Int      @map("language_id")
  name        String   @map("name") @db.NVarChar(100)
  description String?  @map("description") @db.NVarChar(2000)
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")
  
  exercise    Exercise @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade)
  language    Language @relation(fields: [language_id], references: [language_id], onDelete: Cascade)

  @@id([exercise_id, language_id])
  @@map("exercise_translations")
  @@schema("aaExercise")
}

/// Egzersiz-kas hedefleri - Composite PK (M:N)
model ExerciseTargetMuscle {
  exercise_id      Int      @map("exercise_id")
  muscle_id        Int      @map("muscle_id")
  effect_on_muscle Int      @default(5) @map("effect_on_muscle") // 1, 5, or 10
  created_at       DateTime @default(now()) @map("created_at")
  
  exercise         Exercise @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade)
  muscle           Muscle   @relation(fields: [muscle_id], references: [muscle_id], onDelete: Cascade)

  @@id([exercise_id, muscle_id])
  @@map("exercise_target_muscles")
  @@schema("aaExercise")
}

/// Egzersiz-ekipman ilişkisi - Composite PK (M:N)
model ExerciseEquipment {
  exercise_id  Int       @map("exercise_id")
  equipment_id Int       @map("equipment_id")
  created_at   DateTime  @default(now()) @map("created_at")
  
  exercise     Exercise  @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade)
  equipment    Equipment @relation(fields: [equipment_id], references: [equipment_id], onDelete: Cascade)

  @@id([exercise_id, equipment_id])
  @@map("exercise_equipment")
  @@schema("aaExercise")
}

/// Egzersiz medyaları
model ExerciseMedia {
  exercise_media_id Int      @id @default(autoincrement()) @map("exercise_media_id")
  exercise_id       Int      @map("exercise_id")
  media_type        String   @map("media_type") @db.NVarChar(20) // IMAGE, VIDEO, GIF
  media_url         String   @map("media_url") @db.NVarChar(500)
  thumbnail_url     String?  @map("thumbnail_url") @db.NVarChar(500)
  created_at        DateTime @default(now()) @map("created_at")
  updated_at        DateTime @updatedAt @map("updated_at")
  
  exercise          Exercise @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade)

  @@map("exercise_media")
  @@schema("aaExercise")
}

/// Egzersiz-sakatlık kısıtlamaları - Composite PK
model ExerciseLimitation {
  exercise_id          Int              @map("exercise_id")
  health_limitation_id Int              @map("health_limitation_id")
  max_severity_allowed Int              @map("max_severity_allowed") // 1, 2, or 3
  created_at           DateTime         @default(now()) @map("created_at")
  
  exercise             Exercise         @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade)
  health_limitation    HealthLimitation @relation(fields: [health_limitation_id], references: [health_limitation_id], onDelete: Cascade)

  @@id([exercise_id, health_limitation_id])
  @@map("exercise_limitations")
  @@schema("aaExercise")
}

