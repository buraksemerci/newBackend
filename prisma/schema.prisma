// FitMark Database Schema
// SQL Server (Azure SQL) with custom schemas
// Schemas: aaAuth, aaProfile, aaMaster
// ID Strategy: UUID for external-facing, INT for internal

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["aaAuth", "aaProfile", "aaMaster"]
}

// ============================================================================
// aaAuth SCHEMA - Authentication & Authorization
// ============================================================================

/// Ana kullanıcı tablosu - UUID (güvenlik için)
model User {
  id                      String    @id @default(uuid()) @map("id") @db.NVarChar(36)
  email                   String    @unique @map("email") @db.NVarChar(255)
  username                String    @unique @map("username") @db.NVarChar(30)
  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  usernameLastChangedAt   DateTime? @map("username_last_changed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  // Relations
  profile                 UserProfile?
  body                    UserBody?
  settings                UserSetting?
  goals                   UserGoals?
  localCredential         UserLocalCredential?
  externalLogins          UserExternalLogin[]
  devices                 UserDevice[]
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  healthLimitations       UserHealthLimitation[]
  equipment               UserEquipment[]
  workoutLocations        UserWorkoutLocation[]

  @@map("users")
  @@schema("aaAuth")
}

/// Şifre bilgileri - INT (iç tablo)
model UserLocalCredential {
  id                   Int       @id @default(autoincrement()) @map("id")
  userId               String    @unique @map("user_id") @db.NVarChar(36)
  passwordHash         String    @map("password_hash") @db.NVarChar(255)
  failedAttempts       Int       @default(0) @map("failed_attempts")
  lockedUntil          DateTime? @map("locked_until")
  lastPasswordChangeAt DateTime  @default(now()) @map("last_password_change_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_local_credentials")
  @@schema("aaAuth")
}

/// Sosyal login bilgileri - INT (iç tablo)
model UserExternalLogin {
  id          Int      @id @default(autoincrement()) @map("id")
  userId      String   @map("user_id") @db.NVarChar(36)
  provider    String   @map("provider") @db.NVarChar(20) // GOOGLE, APPLE, FACEBOOK
  providerKey String   @map("provider_key") @db.NVarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerKey])
  @@map("user_external_logins")
  @@schema("aaAuth")
}

/// Refresh tokenları - UUID (güvenlik için)
model RefreshToken {
  id        String   @id @default(uuid()) @map("id") @db.NVarChar(36)
  userId    String   @map("user_id") @db.NVarChar(36)
  deviceId  String   @map("device_id") @db.NVarChar(36)
  tokenHash String   @unique @map("token_hash") @db.NVarChar(128)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refresh_tokens")
  @@schema("aaAuth")
}

/// Birleşik doğrulama tokenları (email verification + password reset)
/// type: EMAIL_VERIFICATION | PASSWORD_RESET
model VerificationToken {
  id           String   @id @default(uuid()) @map("id") @db.NVarChar(36)
  userId       String   @map("user_id") @db.NVarChar(36)
  type         String   @map("type") @db.NVarChar(30) // EMAIL_VERIFICATION, PASSWORD_RESET
  tokenHash    String   @map("token_hash") @db.NVarChar(128)
  expiresAt    DateTime @map("expires_at")
  isUsed       Boolean  @default(false) @map("is_used")
  attemptsLeft Int      @default(5) @map("attempts_left") // Email verification için
  sentCount    Int      @default(1) @map("sent_count") // Resend tracking
  lastSentAt   DateTime @default(now()) @map("last_sent_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type]) // Her tip için kullanıcı başına tek aktif token
  @@map("verification_tokens")
  @@schema("aaAuth")
}

/// Cihaz bilgileri - UUID (dışarıya açık)
model UserDevice {
  id           String   @id @default(uuid()) @map("id") @db.NVarChar(36)
  userId       String   @map("user_id") @db.NVarChar(36)
  deviceId     String   @map("device_id") @db.NVarChar(100)
  deviceName   String?  @map("device_name") @db.NVarChar(100)
  deviceType   String   @map("device_type") @db.NVarChar(20) // IOS, ANDROID, WEB
  fcmToken     String?  @map("fcm_token") @db.NVarChar(500)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@map("user_devices")
  @@schema("aaAuth")
}

// ============================================================================
// aaProfile SCHEMA - User Profile & Preferences
// ============================================================================

/// Profil bilgileri - userId PK (1:1 ilişki)
model UserProfile {
  userId    String   @id @map("user_id") @db.NVarChar(36)
  firstName String   @map("first_name") @db.NVarChar(50)
  lastName  String   @map("last_name") @db.NVarChar(50)
  birthDate DateTime @map("birth_date")
  gender    String   @map("gender") @db.NVarChar(10) // MALE, FEMALE, OTHER
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
  @@schema("aaProfile")
}

/// Vücut ölçüleri - userId PK (1:1 ilişki)
model UserBody {
  userId         String   @id @map("user_id") @db.NVarChar(36)
  heightCm       Decimal  @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal  @map("weight_kg") @db.Decimal(5, 2)
  targetWeightKg Decimal? @map("target_weight_kg") @db.Decimal(5, 2)
  somatotype     String   @map("somatotype") @db.NVarChar(20) // ECTOMORPH, MESOMORPH, ENDOMORPH
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_bodies")
  @@schema("aaProfile")
}

/// Kullanıcı ayarları - userId PK (1:1 ilişki)
model UserSetting {
  userId            String   @id @map("user_id") @db.NVarChar(36)
  preferredUnit     String   @default("METRIC") @map("preferred_unit") @db.NVarChar(20) // METRIC, IMPERIAL
  languageId        Int      @map("language_id")
  theme             String   @default("SYSTEM") @map("theme") @db.NVarChar(20) // LIGHT, DARK, SYSTEM
  workoutReminders  Boolean  @default(true) @map("workout_reminders")
  progressUpdates   Boolean  @default(true) @map("progress_updates")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_settings")
  @@schema("aaProfile")
}

/// Kullanıcı hedefleri - userId PK (1:1 ilişki)
model UserGoals {
  userId        String   @id @map("user_id") @db.NVarChar(36)
  fitnessGoalId Int      @map("fitness_goal_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessGoal FitnessGoal    @relation(fields: [fitnessGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bodyTargets UserBodyTarget[]

  @@map("user_goals")
  @@schema("aaProfile")
}

/// Kullanıcı sağlık kısıtlamaları - INT (junction)
model UserHealthLimitation {
  id                 Int      @id @default(autoincrement()) @map("id")
  userId             String   @map("user_id") @db.NVarChar(36)
  healthLimitationId Int      @map("health_limitation_id")
  createdAt          DateTime @default(now()) @map("created_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthLimitation HealthLimitation @relation(fields: [healthLimitationId], references: [id], onDelete: Cascade)

  @@unique([userId, healthLimitationId])
  @@map("user_health_limitations")
  @@schema("aaProfile")
}

/// Kullanıcı ekipmanları - INT (junction)
model UserEquipment {
  id          Int      @id @default(autoincrement()) @map("id")
  userId      String   @map("user_id") @db.NVarChar(36)
  equipmentId Int      @map("equipment_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
  @@map("user_equipment")
  @@schema("aaProfile")
}

/// Kullanıcı antrenman lokasyonları - INT (junction)
model UserWorkoutLocation {
  id                Int      @id @default(autoincrement()) @map("id")
  userId            String   @map("user_id") @db.NVarChar(36)
  workoutLocationId Int      @map("workout_location_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutLocation WorkoutLocation @relation(fields: [workoutLocationId], references: [id], onDelete: Cascade)

  @@unique([userId, workoutLocationId])
  @@map("user_workout_locations")
  @@schema("aaProfile")
}

/// Kullanıcı vücut hedefleri - INT (junction to UserGoals)
model UserBodyTarget {
  id              Int      @id @default(autoincrement()) @map("id")
  userGoalsUserId String   @map("user_goals_user_id") @db.NVarChar(36)
  bodyTargetId    Int      @map("body_target_id")
  createdAt       DateTime @default(now()) @map("created_at")

  userGoals  UserGoals  @relation(fields: [userGoalsUserId], references: [userId], onDelete: Cascade)
  bodyTarget BodyTarget @relation(fields: [bodyTargetId], references: [id], onDelete: Cascade)

  @@unique([userGoalsUserId, bodyTargetId])
  @@map("user_body_targets")
  @@schema("aaProfile")
}

// ============================================================================
// aaMaster SCHEMA - Lookup/Reference Data
// ============================================================================

/// Diller - INT (lookup)
model Language {
  id        Int      @id @default(autoincrement()) @map("id")
  code      String   @unique @map("code") @db.NVarChar(10) // en, tr
  name      String   @map("name") @db.NVarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  fitnessGoalTranslations        FitnessGoalTranslation[]
  bodyTargetTranslations         BodyTargetTranslation[]
  healthLimitationTranslations   HealthLimitationTranslation[]
  equipmentTranslations          EquipmentTranslation[]
  workoutLocationTranslations    WorkoutLocationTranslation[]
  userSettings                   UserSetting[]

  @@map("languages")
  @@schema("aaMaster")
}

/// Fitness hedefleri - INT (lookup)
model FitnessGoal {
  id        Int      @id @default(autoincrement()) @map("id")
  key       String   @unique @map("key") @db.NVarChar(50) // lose_weight, build_muscle, maintain, gain_endurance, improve_flexibility
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations FitnessGoalTranslation[]
  userGoals    UserGoals[]

  @@map("fitness_goals")
  @@schema("aaMaster")
}

/// Fitness hedefi çevirileri - INT (translation)
model FitnessGoalTranslation {
  id            Int      @id @default(autoincrement()) @map("id")
  fitnessGoalId Int      @map("fitness_goal_id")
  languageId    Int      @map("language_id")
  name          String   @map("name") @db.NVarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fitnessGoal FitnessGoal @relation(fields: [fitnessGoalId], references: [id], onDelete: Cascade)
  language    Language    @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([fitnessGoalId, languageId])
  @@map("fitness_goal_translations")
  @@schema("aaMaster")
}

/// Vücut hedefleri - INT (lookup)
model BodyTarget {
  id           Int      @id @default(autoincrement()) @map("id")
  key          String   @map("key") @db.NVarChar(50) // chest, back, arms
  targetGender String   @map("target_gender") @db.NVarChar(10) // MALE, FEMALE
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  translations    BodyTargetTranslation[]
  userBodyTargets UserBodyTarget[]

  @@unique([key, targetGender])
  @@map("body_targets")
  @@schema("aaMaster")
}

/// Vücut hedefi çevirileri - INT (translation)
model BodyTargetTranslation {
  id           Int      @id @default(autoincrement()) @map("id")
  bodyTargetId Int      @map("body_target_id")
  languageId   Int      @map("language_id")
  name         String   @map("name") @db.NVarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bodyTarget BodyTarget @relation(fields: [bodyTargetId], references: [id], onDelete: Cascade)
  language   Language   @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([bodyTargetId, languageId])
  @@map("body_target_translations")
  @@schema("aaMaster")
}

/// Sağlık kısıtlamaları - INT (lookup)
model HealthLimitation {
  id        Int      @id @default(autoincrement()) @map("id")
  key       String   @unique @map("key") @db.NVarChar(50) // back_pain, knee_injury
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations          HealthLimitationTranslation[]
  userHealthLimitations UserHealthLimitation[]

  @@map("health_limitations")
  @@schema("aaMaster")
}

/// Sağlık kısıtlaması çevirileri - INT (translation)
model HealthLimitationTranslation {
  id                 Int      @id @default(autoincrement()) @map("id")
  healthLimitationId Int      @map("health_limitation_id")
  languageId         Int      @map("language_id")
  name               String   @map("name") @db.NVarChar(100)
  description        String?  @map("description") @db.NVarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  healthLimitation HealthLimitation @relation(fields: [healthLimitationId], references: [id], onDelete: Cascade)
  language         Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([healthLimitationId, languageId])
  @@map("health_limitation_translations")
  @@schema("aaMaster")
}

/// Ekipmanlar - INT (lookup)
model Equipment {
  id        Int      @id @default(autoincrement()) @map("id")
  key       String   @unique @map("key") @db.NVarChar(50) // bodyweight, dumbbell
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations  EquipmentTranslation[]
  userEquipment UserEquipment[]

  @@map("equipment")
  @@schema("aaMaster")
}

/// Ekipman çevirileri - INT (translation)
model EquipmentTranslation {
  id          Int      @id @default(autoincrement()) @map("id")
  equipmentId Int      @map("equipment_id")
  languageId  Int      @map("language_id")
  name        String   @map("name") @db.NVarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  language  Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, languageId])
  @@map("equipment_translations")
  @@schema("aaMaster")
}

/// Antrenman lokasyonları - INT (lookup)
model WorkoutLocation {
  id        Int      @id @default(autoincrement()) @map("id")
  key       String   @unique @map("key") @db.NVarChar(50) // home, gym, park
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations         WorkoutLocationTranslation[]
  userWorkoutLocations UserWorkoutLocation[]

  @@map("workout_locations")
  @@schema("aaMaster")
}

/// Antrenman lokasyonu çevirileri - INT (translation)
model WorkoutLocationTranslation {
  id                Int      @id @default(autoincrement()) @map("id")
  workoutLocationId Int      @map("workout_location_id")
  languageId        Int      @map("language_id")
  name              String   @map("name") @db.NVarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workoutLocation WorkoutLocation @relation(fields: [workoutLocationId], references: [id], onDelete: Cascade)
  language        Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([workoutLocationId, languageId])
  @@map("workout_location_translations")
  @@schema("aaMaster")
}
