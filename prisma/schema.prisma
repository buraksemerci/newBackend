/// Egzersiz özellikleri/attribute - INT (lookup)
model Attribute {
  attribute_id  Int      @id @default(autoincrement()) @map("attribute_id")
  attribute_key String   @unique @map("attribute_key") @db.NVarChar(50)
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")
  
  exercise_attributes ExerciseAttributeRelation[]
  goal_attributes     FitnessGoalAttribute[]

  @@map("attributes")
  @@schema("aaMaster")
}

/// Fitness hedefi - Attribute ilişkisi
model FitnessGoalAttribute {
  fitness_goal_id     Int      @map("fitness_goal_id")
  attribute_id        Int      @map("attribute_id")
  weight_on_attribute Int      @default(5) @map("weight_on_attribute") // 1, 5, or 10
  created_at          DateTime @default(now()) @map("created_at")
  
  fitness_goal        FitnessGoal @relation(fields: [fitness_goal_id], references: [fitness_goal_id], onDelete: Cascade)
  attribute           Attribute   @relation(fields: [attribute_id], references: [attribute_id], onDelete: Cascade)

  @@id([fitness_goal_id, attribute_id])
  @@map("fitness_goal_attributes")
  @@schema("aaMaster")
}

/// Egzersiz - Attribute ilişkisi
model ExerciseAttributeRelation {
  exercise_id              Int      @map("exercise_id")
  attribute_id             Int      @map("attribute_id")
  exercise_attribute_level Int      @default(5) @map("exercise_attribute_level") // 1, 5, or 10
  created_at               DateTime @default(now()) @map("created_at")
  
  exercise                 Exercise  @relation(fields: [exercise_id], references: [exercise_id], onDelete: Cascade)
  attribute                Attribute @relation(fields: [attribute_id], references: [attribute_id], onDelete: Cascade)

  @@id([exercise_id, attribute_id])
  @@map("exercise_attribute_relations")
  @@schema("aaExercise")
}

/// Deneyim seviyeleri
model ExperienceLevel {
  experience_level_id  Int           @id @default(autoincrement()) @map("experience_level_id")
  experience_level_key String        @unique @map("experience_level_key") @db.NVarChar(20)
  created_at           DateTime      @default(now()) @map("created_at")
  updated_at           DateTime      @updatedAt @map("updated_at")
  
  user_profiles        UserProfile[]

  @@map("experience_levels")
  @@schema("aaMaster")
}

/// Kas alt grupları
model MuscleSubgroup {
  muscle_subgroup_id  Int      @id @default(autoincrement()) @map("muscle_subgroup_id")
  muscle_subgroup_key String   @unique @map("muscle_subgroup_key") @db.NVarChar(30)
  muscle_group        String   @map("muscle_group") @db.NVarChar(20) // UPPER, CORE, LOWER
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")
  
  muscle_relations    MuscleSubgroupRelation[]
  body_targets        BodyTarget[]

  @@map("muscle_subgroups")
  @@schema("aaExercise")
}

/// Kas - Alt grup ilişkisi (M:N)
model MuscleSubgroupRelation {
  muscle_id          Int      @map("muscle_id")
  muscle_subgroup_id Int      @map("muscle_subgroup_id")
  created_at         DateTime @default(now()) @map("created_at")
  
  muscle             Muscle         @relation(fields: [muscle_id], references: [muscle_id], onDelete: Cascade)
  muscle_subgroup    MuscleSubgroup @relation(fields: [muscle_subgroup_id], references: [muscle_subgroup_id], onDelete: Cascade)

  @@id([muscle_id, muscle_subgroup_id])
  @@map("muscle_subgroup_relations")
  @@schema("aaExercise")
}
